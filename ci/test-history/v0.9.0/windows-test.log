  left: "# Archx 5-Way Full-Feature Comparison — Edition 1 & 2:\r\n#   - `full_tour.py`                  (Python 3.10+)\r\n#   - `full_tour_pythonic.archx.lang` (Archx 1:1 Pythonic — byte-for-byte identical source!)\r\n#\r\n# Exercises every milestone (v0.1.0 - v0.9.0):\r\n#   classes & float N-body physics, strings & slicing, lists/dicts/sets,\r\n#   adaptive dynamic rebinding, multiple-return tuples, `T | None` optionals\r\n#   with flow-sensitive narrowing, `match`/`case` with `|` & `if` guards,\r\n#   comprehensions & generator folds, PEP 695 generics, zero-heap `lambda`,\r\n#   `zip(...)`, and inline monomorphized `sorted`/`sort(key=...)`/`reverse=True`.\r\n\r\n\r\nclass Body:\r\n    def __init__(self, x: float, y: float, vx: float, vy: float, mass: float):\r\n        self.x = x\r\n        self.y = y\r\n        self.vx = vx\r\n        self.vy = vy\r\n        self.mass = mass\r\n\r\n    def kinetic(self) -> float:\r\n        return 0.5 * self.mass * (self.vx * self.vx + self.vy * self.vy)\r\n\r\n\r\ndef simulate_field(n: int, steps: int) -> int:\r\n    bodies: list[Body] = []\r\n    for i in range(n):\r\n        fi = float(i + 1)\r\n        bodies.append(Body(fi * 0.001, fi * -0.002, 0.02, -0.015, 1.0 + fi * 0.0002))\r\n\r\n    dt = 0.01\r\n    for _s in range(steps):\r\n        for i in range(n):\r\n            bx = bodies[i].x\r\n            by = bodies[i].y\r\n            r2 = bx * bx + by * by + 1.0\r\n            inv = dt / (r2 ** 0.5)\r\n            bodies[i].vx -= bx * inv\r\n            bodies[i].vy -= by * inv\r\n            bodies[i].x += bodies[i].vx * dt\r\n            bodies[i].y += bodies[i].vy * dt\r\n\r\n    ke = 0.0\r\n    for i in range(n):\r\n        ke += bodies[i].kinetic()\r\n    return int(ke * 1000.0)\r\n\r\n\r\ndef dict_and_slicing_tour(rounds: int) -> tuple[int, str]:\r\n    vocab: list[str] = []\r\n    for i in range(512):\r\n        if i % 2 == 0:\r\n            vocab.append(f\"tok_{i}\")\r\n        else:\r\n            raw = f\"   Telemetry_Channel_{i}  \"\r\n            vocab.append(raw.strip().lower())\r\n\r\n    banner = \"archx_systems_python\"[::-1]\r\n    checksum = 0\r\n    miss = \"absent_channel_key\"\r\n\r\n    for r in range(rounds):\r\n        counts = {}\r\n        seen = set()\r\n        for i in range(512):\r\n            counts[vocab[i]] = 1\r\n        for step in range(4096):\r\n            idx = (step * 73 + r * 19) % 512\r\n            key = vocab[idx]\r\n            counts[key] += (step % 5) + 1\r\n            if step < 64:\r\n                seen.add(idx)\r\n        for p in range(1024):\r\n            pk = vocab[(p * 131 + r * 7) % 512]\r\n            checksum += counts.get(pk, 0)\r\n        if miss not in counts:\r\n            checksum += len(seen)\r\n        for _k, v in counts.items():\r\n            checksum += v\r\n\r\n    nums = [10, 25, 40, 55, 70, 85, 100, 115]\r\n    sliced = nums[1:7:2]\r\n    checksum += sliced[0] + sliced[-1] + nums[-1]\r\n    return checksum, banner\r\n\r\n\r\ndef analyze_series(xs: list[int]) -> tuple[int, int, int]:\r\n    lo = xs[0]\r\n    hi = xs[0]\r\n    total = 0\r\n    for x in xs:\r\n        if x < lo:\r\n            lo = x\r\n        if x > hi:\r\n            hi = x\r\n        total += x\r\n    return lo, hi, total\r\n\r\n\r\ndef find_spike(xs: list[int], threshold: int) -> int | None:\r\n    for i, x in enumerate(xs):\r\n        if x >= threshold:\r\n            return i * 1000 + x\r\n\r\n\r\ndef dispatch_events(total_events: int) -> int:\r\n    acc = 0\r\n    for i in range(total_events):\r\n        kind = i % 5\r\n        a = (i * 17 + 3) % 40\r\n        b = (i * 13 + 7) % 25\r\n        ev = (kind, a, b)\r\n        match ev:\r\n            case (0, r, _) if r > 20:\r\n                acc += r * r + 7\r\n            case (0, r, _):\r\n                acc += r * 3 + 1\r\n            case (1, w, h):\r\n                acc += w * h\r\n            case (2, s, _) | (3, s, _):\r\n                acc += s * 4 + 2\r\n            case _:\r\n                acc += 1\r\n    return acc\r\n\r\n\r\ndef pipeline_tour(n: int) -> int:\r\n    # v0.9.0: comprehensions, generator folds, zip, and inline monomorphized sorting.\r\n    squares = [x * x for x in range(n)]\r\n    evens = [x for x in squares if x % 2 == 0]\r\n    acc = sum(evens)\r\n    acc += sum(x for x in range(n) if x % 3 == 0)\r\n    acc += max(x * 2 for x in range(n))\r\n    acc += min(x * 3 + 1 for x in range(n))\r\n    if any(x > n for x in range(n)):\r\n        acc += 1\r\n    if all(x >= 0 for x in range(n)):\r\n        acc += 2\r\n\r\n    left = [i for i in range(n)]\r\n    right = [n - i for i in range(n)]\r\n    for a, b in zip(left, right):\r\n        acc += a * b\r\n\r\n    raw = [(i * 37) % 997 for i in range(n)]\r\n    asc = sorted(raw)\r\n    desc = sorted(raw, reverse=True)\r\n    by_neg = sorted(raw, key=lambda v: -v)\r\n    inplace = [x for x in raw]\r\n    inplace.sort()\r\n    for i in range(8):\r\n        acc += asc[i] + desc[i] + by_neg[i] + inplace[i]\r\n    for v in by_neg:\r\n        acc += v % 7\r\n    return acc\r\n\r\n\r\ndef main():\r\n    # Adaptive dynamic variable (valid Python + Archx Tier-2 `%ArchxAny`)\r\n    mode = \"initializing\"\r\n    mode = 8\r\n\r\n    sim_score = simulate_field(40000, 30)\r\n    dict_score, rev_banner = dict_and_slicing_tour(60)\r\n\r\n    series: list[int] = []\r\n    for i in range(64):\r\n        series.append(((i * 37 + 11) % 97) + mode)\r\n    lo, hi, total = analyze_series(series)\r\n\r\n    hit = find_spike(series, 95)\r\n    miss = find_spike(series, 999)\r\n    hit_out = hit + 1 if hit is not None else -1\r\n    miss_label = \"none\"\r\n    match miss:\r\n        case None:\r\n            miss_label = \"empty\"\r\n        case v:\r\n            miss_label = f\"val_{v}\"\r\n\r\n    dispatch_score = dispatch_events(200000)\r\n    pipeline_score = pipeline_tour(2000)\r\n\r\n    print(f\"sim={sim_score}\")\r\n    print(f\"dict_slice={dict_score},{rev_banner}\")\r\n    print(f\"tuple_opt={lo},{hi},{total},{hit_out},{miss_label}\")\r\n    print(f\"match_dispatch={dispatch_score}\")\r\n    print(f\"pipeline={pipeline_score}\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"
 right: "\r\n# Archx 5-Way Full-Feature Comparison — Edition 1 & 2:\r\n#   - `full_tour.py`                  (Python 3.10+)\r\n#   - `full_tour_pythonic.archx.lang` (Archx 1:1 Pythonic — byte-for-byte identical source!)\r\n#\r\n# Exercises every milestone (v0.1.0 - v0.9.0):\r\n#   classes & float N-body physics, strings & slicing, lists/dicts/sets,\r\n#   adaptive dynamic rebinding, multiple-return tuples, `T | None` optionals\r\n#   with flow-sensitive narrowing, `match`/`case` with `|` & `if` guards,\r\n#   comprehensions & generator folds, PEP 695 generics, zero-heap `lambda`,\r\n#   `zip(...)`, and inline monomorphized `sorted`/`sort(key=...)`/`reverse=True`.\r\n\r\n\r\nclass Body:\r\n    def __init__(self, x: float, y: float, vx: float, vy: float, mass: float):\r\n        self.x = x\r\n        self.y = y\r\n        self.vx = vx\r\n        self.vy = vy\r\n        self.mass = mass\r\n\r\n    def kinetic(self) -> float:\r\n        return 0.5 * self.mass * (self.vx * self.vx + self.vy * self.vy)\r\n\r\n\r\ndef simulate_field(n: int, steps: int) -> int:\r\n    bodies: list[Body] = []\r\n    for i in range(n):\r\n        fi = float(i + 1)\r\n        bodies.append(Body(fi * 0.001, fi * -0.002, 0.02, -0.015, 1.0 + fi * 0.0002))\r\n\r\n    dt = 0.01\r\n    for _s in range(steps):\r\n        for i in range(n):\r\n            bx = bodies[i].x\r\n            by = bodies[i].y\r\n            r2 = bx * bx + by * by + 1.0\r\n            inv = dt / (r2 ** 0.5)\r\n            bodies[i].vx -= bx * inv\r\n            bodies[i].vy -= by * inv\r\n            bodies[i].x += bodies[i].vx * dt\r\n            bodies[i].y += bodies[i].vy * dt\r\n\r\n    ke = 0.0\r\n    for i in range(n):\r\n        ke += bodies[i].kinetic()\r\n    return int(ke * 1000.0)\r\n\r\n\r\ndef dict_and_slicing_tour(rounds: int) -> tuple[int, str]:\r\n    vocab: list[str] = []\r\n    for i in range(512):\r\n        if i % 2 == 0:\r\n            vocab.append(f\"tok_{i}\")\r\n        else:\r\n            raw = f\" 