# v0.9.1 — Pythonic call & loop semantics, verified byte-identical to CPython
# (see tests/cli.rs::pythonic_defaults_else_keywords_and_map_filter).

def greet(name: str, punct: str = "!", loud: bool = false) -> str:
    if loud:
        return name + punct + punct
    return name + punct

def rect(w: int, h: int = 2) -> int:
    return w * h

def sq(x: int) -> int:
    return x * x

def odd(x: int) -> bool:
    return x % 2 == 1

def find(target: int) -> str:
    for i in range(4):
        if i == target:
            return "found"
    else:
        return "missing"

def main():
    print(greet("hi"), greet("hi", punct="?"), greet(loud=true, name="hey"))
    print(rect(5), rect(h=3, w=4))
    print(find(2), find(9))

    # Loop variables stay bound after the loop, in Python's function scope.
    for j in range(2):
        pass
    print(j)

    nums = [1, 2, 3, 4, 5]
    print(list(map(sq, nums)))
    print(list(filter(odd, nums)))
    print(list(map(lambda x: x * 2, nums)))
    print(sum(map(sq, nums)))

    print(sorted([("b", 2), ("a", 1), ("a", 0)]))
    print(sorted([3, 1, 2], reverse=True))
main()
