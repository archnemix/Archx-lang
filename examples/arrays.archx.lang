# Arrays, indexing, dynamic push/pop, elif, and compound assignment.

func dot(a: [int], b: [int]) -> int:
    let total = 0
    for i in 0..len(a):
        total += a[i] * b[i]
    return total

func sieve_count(limit: int) -> int:
    let is_prime = [true; limit]
    is_prime[0] = false
    is_prime[1] = false

    let p = 2
    while p * p < limit:
        if is_prime[p]:
            let j = p * p
            while j < limit:
                is_prime[j] = false
                j += p
        p += 1

    let count = 0
    for i in 2..limit:
        if is_prime[i]:
            count += 1
    return count

func classify(score: int) -> string:
    if score >= 90:
        return "A"
    elif score >= 80:
        return "B"
    elif score >= 70:
        return "C"
    else:
        return "F"

